{% extends "layout.twig" %}

{% block extraHead %}
    <script src="/js/boundary-autocomplete.js"></script>
    <script>
        window.boundaryDataFromUrl = {{ boundaryDataJson|raw|default('[]') }};
    </script>
{% endblock %}

{% block content %}

     {{ alert|raw }}

    {% include 'announcment.twig' ignore missing %}
    
    {% if filters is defined and filters|length %}
        <div class="search-params-chips">
            <span class="search-params-label">Szűrők:</span>
            {% for filter in filters %}
                <span class="search-param-chip">{{ filter|raw }}</span>
            {% endfor %}
        </div>
    {% endif %}

    {% if churches %}
        <div class="results-count">
            Összesen: <strong>{{ pagination.resultsCount }}</strong> találat &nbsp;·&nbsp;
            Listázás: <strong>{{ (pagination.active * pagination.take) + 1 }} –
            {% if pagination.resultsCount < ( pagination.active + 1 ) * pagination.take %}
                {{ pagination.resultsCount }}
            {% else %}
                {{ ( pagination.active + 1 ) * pagination.take }}
            {% endif %}</strong>
        </div>

        {% for church in churches %}
            <div class="church-result-card">
                <a href='/templom/{{ church.id }}' class="church-result-link" title='{{ church.names|slice(1)|join(', ') }}'>
                    <span class="church-result-name">{{ church.names.0 }}</span>
                    <span class="church-result-city">
                        {% if church.varos is iterable %}
                            {{ church.varos.0 }}
                        {% else %}
                            {{ church.varos }}
                        {% endif %}
                    </span>
                </a>
                {% if user.isadmin %}
                    <small class="text-muted">{{ church.score }}</small>
                {% endif %}
                {% if church.alternative_names.0 %}
                    <span class="church-result-altname" title="{{ church.alternative_names|slice(1)|join(', ') }}">{{ church.alternative_names.0 }}</span>
                {% endif %}
                {% if user.isadmin %}
                    <div class="church-result-adminlinks">
                        {% include "church/_adminlinks.twig" with church %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    {% endif %}

    {% include '_pagination.twig' %}
{% endblock %}

{% block leftsidebar %}
    {% include "_panelsearchforchurch.twig" %}
{% endblock %}
