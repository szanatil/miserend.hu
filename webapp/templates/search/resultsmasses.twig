{% set columns2 = true  %}

{% extends "layout.twig" %}



{% block extraHead %}
    <script src="/js/unified-autocomplete.js"></script>
    <script>
        window.boundaryDataFromUrl = {{ boundaryDataJson|raw|default('[]') }};
        window.churchDataFromUrl = {{ churchDataJson|raw|default('[]') }};
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof UnifiedAutocomplete !== 'undefined') {
                UnifiedAutocomplete.init('#keyword', '#panel-search-mass-form', {
                    initialBoundaries: window.boundaryDataFromUrl || [],
                    initialChurches: window.churchDataFromUrl || []
                });
            }
        });
    </script>
    <style>
        /* #515: régi-adat jelzés a találati listában (mint a templomoldalon) */
        .mass-results-table tr.mass-row--stale td { text-decoration: line-through; opacity: .55; }
        .mass-row-freshness { margin-left: 6px; cursor: help; }
        .mass-row-freshness--stale { color: #b02a37; }
        .mass-row-freshness--medium { color: #997404; }
    </style>
{% endblock %}


{% block pageHeader %}
    <div class="page-header">
        <h1>{{ title|raw }}</h1>
    </div>
    {% include 'announcment.twig' ignore missing %}
{%  endblock %}

{% block content %}

    {{ alert|raw }}
    {{ tartalom|raw }}
    <strong><span class=kiscim>Keresési paraméterek:</span></strong><br/>
    {% if filters is defined and filters|length %}
        {% for filter in filters %}
            <span class="alap"><img src="/img/negyzet_lila.gif" align="absmiddle"> {{ filter|raw }}</span><br/>
        {% endfor %}
    {% else %}
        <span class="alap">Nincsenek szűrők</span><
    {% endif %}
    <br/>

    {% if results %}

            <div class="row" style="margin-bottom:12px">
                <p>
                Listázott találatok: <strong>{{ (pagination.active * pagination.take) + 1 }} - 
                {% if pagination.resultsCount < ( pagination.active + 1 ) * pagination.take %}
                    {{ pagination.resultsCount }}
                {% else %}
                    {{ ( pagination.active + 1 ) * pagination.take }} 
                {% endif %}</strong>
                (Összesen: <strong>{{ pagination.resultsCount }}</strong>)
                </p>
            </div>

            <table class="table mass-results-table">
                <tbody>
                {% set previousDate = null %}
                {% set rowCounter = 0 %}
                {% for result in results %}
                    {% set church = result.church %}
                    {# #515: régi-adat jelzés a templom frissítettsége alapján (mint a templomoldalon: 180 nap / 1825 nap) #}
                    {% set freshTs = (church.frissites and church.frissites != '0000-00-00') ? church.frissites|date('U') : null %}
                    {% set daysAgo = freshTs ? (("now"|date('U')) - freshTs) / 86400 : null %}
                    {% set currentDate = result.start_date|date('Y-m-d') %}
                    {% if previousDate is null or previousDate != currentDate %}
                        <tr class="date-header">
                            <td colspan="5">
                                <span class="date-header-text">
                                    <span>{{ result.start_date|miserend_date('') }}</span>
                                    {% if liturgicalDays[currentDate].name %}
                                        <span class="date-header-liturgy">{{ liturgicalDays[currentDate].name }}</span>
                                    {% endif %}
                                </span>
                            </td>
                        </tr>
                        {% set previousDate = currentDate %}
                        {% set rowCounter = 0 %}
                    {% endif %}
                    {% set rowClasses = [] %}
                    {% if rowCounter % 2 == 1 %}{% set rowClasses = rowClasses|merge(['table-light']) %}{% endif %}
                    {% if daysAgo is not null and daysAgo >= 1825 %}{% set rowClasses = rowClasses|merge(['mass-row--stale']) %}{% endif %}
                    <tr{% if rowClasses|length %} class="{{ rowClasses|join(' ') }}"{% endif %}>
                        <td class="align-middle">
                            <span class="badge badge-primary">{{ "%02d:%02d"|format((result.start_minutes / 60)|round(0, 'floor'), (result.start_minutes % 60)) }}</span>
                        </td>

                        <td class="align-middle">
                            <img src="/cal_images/types/{{ result.rite|lower }}.svg" alt="{{ result.rite|trans }}" title="{{ result.rite|trans }}" style="height:1.3em; margin-right:6px; vertical-align:middle;">
                            <strong class="mass-list-title">{{ result.title }}</strong>
                        </td>

                        <td class="align-middle">
                            {# #334: a mise nyelve lista is lehet (szlovák-latin), ilyenkor
                               mindegyikhez kiteszünk egy zászlót. A magyart továbbra sem
                               jelöljük külön — egynyelvű magyar misénél az lenne a zaj. #}
                            {% set massLangs = result.lang is iterable ? result.lang : (result.lang ? [result.lang] : []) %}
                            {% if massLangs != ['hu'] %}
                                {% for lang in massLangs %}
                                    <img src="/cal_images/flags/{{ lang|lower }}.svg" alt="{{ ('LANGUAGES.' ~ lang)|trans }}" title="{{ ('LANGUAGES.' ~ lang)|trans }}" style="height:1.3em; margin-right:6px; vertical-align:middle;">
                                {% endfor %}
                            {% endif %}
                            {% if result.types is iterable and result.types|length %}
                                {% for type in result.types %}
                                    <img src="/cal_images/types/{{ type|lower }}.png" alt="{{ type|trans }}" title="{{ type|trans }}" style="height:1.3em; margin-right:6px; vertical-align:middle;">
                                {% endfor %}
                            {% endif %}
                            {% if result.comment %}
                                <i class='fas fa-info-circle' style='font-size:medium' title='{{ result.comment|striptags }}'></i>
                            {% endif %}
                        </td>

                        <td class="align-middle">
                            <a href='/templom/{{ church.id }}' class=felsomenulink title='{{ church.names|slice(1)|join(', ') }}'>
                                <b>{{ church.names.0 }}</b>
                                <span class="church-result-city">
                                    {% if church.varos is iterable %}
                                        ({{ church.varos.0 }})
                                    {% else %}
                                        ({{ church.varos }})
                                    {% endif %}
                                </span>
                            </a>
                            {% if church.alternative_names.0 %}
                                <br/><span class="alap" style="margin-left: 20px; font-style: italic;" title="{{ church.alternative_names|slice(1)|join(', ') }}">{{ church.alternative_names.0 }}</span>
                            {% endif %}
                            {% if daysAgo is not null and daysAgo >= 1825 %}
                                <i class="fas fa-exclamation-triangle mass-row-freshness mass-row-freshness--stale" title="Az adatok több mint 5 éve nem lettek frissítve – szinte biztosan megbízhatatlanok. Segíts: a templom oldalán szerkeszd a naptárat, vagy küldj észrevételt!"></i>
                            {% elseif daysAgo is not null and daysAgo >= 180 %}
                                <i class="fas fa-exclamation-circle mass-row-freshness mass-row-freshness--medium" title="Az adatok egy ideje nem lettek megerősítve. Segíts: a templom oldalán szerkeszd a naptárat, vagy küldj észrevételt!"></i>
                            {% endif %}
                        </td>
                        <td class="align-middle">
                            {% if result.period or result.mass.rrule %}
                                <span class="badge" style="background-color:{{ result.period.color ?? '' }}" title="{{ result.mass.rrule.readable }}">{{ result.period.name ?? 'Időszak nélkül' }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% set rowCounter = rowCounter + 1 %}
                {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {% include '_pagination.twig' %}


{% endblock %}

{% block leftsidebar %}
    {% include "_panelsearchmass.twig" %}
{% endblock %}
