{% extends 'panel.twig' %}

{% set title = 'Kapcsolat - elérhetőség' %}
{% set panel = 'primary' %}

{% block body %}
    <div class="contact-rows">

        {% if religious_administration.parish.description %}
            <div class="contact-icon-row">
                <div class="text-col">                    
                    {{ religious_administration.parish.description|raw|nl2br|phone_links }}
                </div>
            </div>
        {% endif %}

        {% if religious_administration.parish.email %}
            <div class="contact-icon-row">
                <div class="icon-col"><i class="fa fa-envelope"></i></div>
                <div class="text-col">
                    <a target="_blank" href="mailto:{{ religious_administration.parish.email }}">{{ religious_administration.parish.email }}</a>
                </div>
            </div>
        {% endif %}

        {% if links %}
            {% for link in links %}
                <div class="contact-icon-row">
                    <div class="icon-col"><i class="fa {{ link.icon }}"></i></div>
                    <div class="text-col">
                        <a href="{{ link.href }}">{{ link.title }}</a>
                    </div>
                </div>
            {% endfor %}
        {% endif %}

    </div>
{% endblock %}

{% macro osmlink(osm,title = false) %}
    <a target="_blank" href="http://www.openstreetmap.org/{{ osm.osmtype }}/{{ osm.osmid }}" title="{{ title }}">{{ osm.name }}</a>
{% endmacro %}